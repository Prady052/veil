{
  "name": "veil",
  "version": "1.0.0",
  "private": true,
  "description": "Unlinkable attribute proofs for W3C Verifiable Credentials",
  "workspaces": [
    "packages/core",
    "apps/wallet"
  ],
  "scripts": {
    "issuer": "tsx apps/issuer/server.ts",
    "credential:request": "tsx apps/issuer/request_credential.ts",
    "credential:verify": "tsx scripts/verify_vc.ts",
    "request": "tsx scripts/make_request.ts",
    "input": "tsx scripts/build_input.ts",
    "prove": "tsx scripts/prove.ts",
    "verify": "tsx scripts/verify.ts",
    "setup": "tsx circuits/setup.ts",
    "test": "tsx node_modules/mocha/bin/mocha.js \"circuits/test/**/*.test.ts\" \"packages/core/test/**/*.test.ts\" --exit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/wallet",
    "wallet": "npm run dev -w @veil/wallet",
    "wallet:build": "npm run build -w @veil/wallet",
    "wallet:preview": "npm run preview -w @veil/wallet"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "fastify": "^5.12.5",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "circom_tester": "^0.0.24",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
